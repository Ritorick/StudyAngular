{
  "name": "hello-world-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",

    "electron": "electron .",
    "dist": "ng build --base-href ./ && electron-builder",

    "android:sync": "npx cap sync android",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "android:copy": "copy /Y android\\app\\build\\outputs\\apk\\debug\\app-debug.apk release\\\"Hello World App.apk\"",

    "dist:all": "npm run build && electron-builder && npm run android:sync && npm run android:build && npm run android:copy"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.example.helloworldapp",
    "productName": "Hello World App",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
